{
    "license": "MIT",
    "name": "open-cloning-workspace",
    "version": "0.4.26",
    "type": "module",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "resolutions": {
        "react-redux": "^9.3.1",
        "redux": "^5.0.1",
        "lodash": "^4.18.1",
        "shortid": "^2.2.17",
        "jsondiffpatch": "^0.7.3",
        "@opencloning/opencloning-elabftw": "workspace:*",
        "@opencloning/opencloningdb": "workspace:*",
        "@opencloning/store": "workspace:*",
        "@opencloning/ui": "workspace:*",
        "@opencloning/utils": "workspace:*"
    },
    "scripts": {
        "start": "yarn workspace opencloning start",
        "build": "./scripts/build_opencloning_app.sh",
        "test": "vitest run",
        "lint": "eslint .",
        "pack:all": "yarn workspace @opencloning/store pack --filename /tmp/@opencloning-store.tgz && yarn workspace @opencloning/utils pack --filename /tmp/@opencloning-utils.tgz && yarn workspace @opencloning/ui pack --filename /tmp/@opencloning-ui.tgz"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@clerk/testing": "patch:@clerk/testing@npm%3A2.2.37#~/.yarn/patches/@clerk-testing-npm-2.2.37-69582bb577.patch",
        "@cypress/code-coverage": "^4.1.3",
        "@cypress/react": "^9.0.2",
        "@eslint/js": "^10.0.1",
        "@tanstack/react-query": "^5.107.1",
        "@testing-library/react": "^14.3.1",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/coverage-istanbul": "^5.1.0",
        "@vitest/coverage-v8": "^5.1.0",
        "@vitest/eslint-plugin": "^1.6.28",
        "cypress": "^16.3.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.15.0",
        "eslint-plugin-cypress": "^7.0.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "jsdom": "^31.0.1",
        "knip": "^6.45.1",
        "msw": "^3.0.5",
        "react-redux": "^9.3.1",
        "vite": "^8.3",
        "vite-plugin-istanbul": "^9.0.1",
        "vitest": "^5.1.0"
    },
    "packageManager": "yarn@4.9.1"
}
