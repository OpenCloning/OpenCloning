{
  "name": "OpenCloning frontend",
  // Mounts and capabilities are defined in docker-compose.yml
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "shutdownAction": "stopCompose",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "frontend"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "redhat.vscode-yaml",
        "shelex.vscode-cy-helper",
        "timonwong.shellcheck",
        "vitest.explorer"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteUser": "dev",
  "remoteEnv": {
    "SSH_AUTH_SOCK": ""
  },
  "workspaceFolder": "/workspace",
  "initializeCommand": "git submodule update --init || echo 'Backend submodule not updated; using current version'",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh && /usr/local/bin/check-isolation.sh",
  "postAttachCommand": "/usr/local/bin/check-isolation.sh",
  // Runs before the firewall exists. The node_modules volume takes dev ownership from the image directory
  "postCreateCommand": "yarn install --immutable && yarn cypress install",
  "waitFor": "postStartCommand"
}
